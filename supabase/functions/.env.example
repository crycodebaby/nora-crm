# Template for supabase/functions/.env (local edge-function development).
#
# Copy to `.env` and fill in local dev values. The real `.env` is git-tracked
# for local convenience and MUST hold only throwaway local values. Production
# secrets are configured out of band (dashboard / `supabase secrets set`) and
# never committed.

# Postmark inbound webhook (Basic auth + IP allowlist)
POSTMARK_WEBHOOK_USER=changeme
POSTMARK_WEBHOOK_PASSWORD=changeme
POSTMARK_WEBHOOK_AUTHORIZED_IPS=127.0.0.1

# Inbound mailbox address the app forwards to
VITE_INBOUND_EMAIL=local-inbound@example.com

# Supabase JWT issuer + publishable (public) key for the local stack
SB_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SB_PUBLISHABLE_KEY=your-local-publishable-key

# Public URL of the CRM app, used by the task-list MCP App to build links.
# Leave empty to render contact names as plain text.
CRM_BASE_URL=

# Brevo transactional email event webhook shared secret (inbound bearer token)
BREVO_WEBHOOK_TOKEN=changeme
