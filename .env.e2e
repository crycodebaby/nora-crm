# ============================================================================
# LOCAL E2E ONLY — this file is git-tracked and read by Playwright/CI.
# It must contain ONLY throwaway values for the local `supabase-demo` stack
# (127.0.0.1). NEVER put a real production secret, service-role key, or
# publishable key of the live project here — it would be committed to git.
# Real production secrets live in the Supabase dashboard and Vercel env vars.
# ============================================================================
SKIP_PREFLIGHT_CHECK=true

VITE_SUPABASE_URL=http://127.0.0.1:54341
VITE_SB_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_IS_DEMO=false

# Local service-role credential for the Playwright fixtures.
#
# This is the Supabase CLI's built-in local secret key — the same fixed
# throwaway value every `supabase start` prints, alongside the publishable key
# above. It is NOT a JWT on purpose. The previous value here was a legacy
# service-role JWT *signed by* `supabase/signing_keys.json`; since that private
# key is no longer committed and is generated per machine
# (`npm run signing-keys:ensure`), any JWT minted from the old key now fails
# verification with 401 against PostgREST, GoTrue and Storage. The opaque
# secret key does not depend on the signing key, so it survives regeneration
# and a `db reset`.
SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

VITE_ATTACHMENTS_BUCKET=attachments
